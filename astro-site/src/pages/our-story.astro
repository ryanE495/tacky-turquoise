---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const PORTRAIT = 'https://ozxbjwvwchesjgebenbv.supabase.co/storage/v1/object/public/media/871b6b40-fe6f-4468-bd03-fe65bd9dcc4b.webp';
---
<Base
  title="Our Story"
  description="A small studio in Montrose, Colorado — making turquoise jewelry the slow way, one piece at a time."
>
  <Nav current="story" />


  <!-- 02 · THE MAKER -->
  <section class="story-maker" id="the-maker">
    <div class="story-maker__grid">
      <div class="story-maker__portrait">
        <img src={PORTRAIT} alt="The maker behind Tacky Turquoise" />
      </div>
      <div class="story-maker__body">
        <div class="story-maker__eyebrow">◆ The maker</div>
        <h2 class="story-maker__title">
          Hi, I'm <em>Emily.</em>
        </h2>
        <p class="story-maker__lede">
          Based in the heart of Colorado, my jewelry is deeply inspired by the
          rugged beauty of the mountains and the time spent exploring the outdoors.
        </p>
        <p class="story-maker__copy">
          When I'm not chasing my little one around as a busy mom, you can usually
          find me at my workbench, getting my hands dirty in silver dust.
        </p>
        <p class="story-maker__copy">
          I specialize in handcrafting sterling silver jewelry featuring vibrant
          turquoise and a handpicked selection of other natural stones. For me,
          silversmithing is a way to capture a piece of the earth's wild beauty
          and turn it into wearable art — every piece full of character and built
          to last through your own adventures.
        </p>
        <div class="story-maker__sign">
          <span class="line">Made in Montrose</span>
          <span class="dash">—</span>
          <span class="name">By hand</span>
        </div>
      </div>
    </div>
  </section>



  <Footer />
</Base>
