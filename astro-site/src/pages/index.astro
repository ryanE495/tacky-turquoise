---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import MeetTheMaker from '../components/MeetTheMaker.astro';
import EditorialBanner from '../components/EditorialBanner.astro';
import FeaturedProducts from '../components/FeaturedProducts.astro';
// import Reviews from '../components/Reviews.astro';
// Beaded shop banner hidden for now — restore this import + <ShopNewBanner /> below to bring it back.
// import ShopNewBanner from '../components/ShopNewBanner.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Handmade Turquoise Necklaces"
  description="One-of-a-kind handmade turquoise and sterling silver jewelry, made in Colorado. Each piece is unique. Shipped across the US."
>
  <Hero />
  <EditorialBanner
    title="Silver jewelry,"
    em="made by me."
    breakTitle={true}
    cta="Shop sterling"
    href="/silver-jewelry"
    align="left"
    variant="short"
    image="https://ozxbjwvwchesjgebenbv.supabase.co/storage/v1/object/public/media/f29f5d07-7025-48f4-b552-4f943143c8ba.webp"
  />
  <MeetTheMaker />
  <FeaturedProducts />
  {/* <Reviews /> */}
  {/* <ShopNewBanner /> — beaded shop hidden for now */}
  <Footer />
</Base>
