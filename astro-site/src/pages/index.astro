---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ShopNewBanner from '../components/ShopNewBanner.astro';
import MeetTheMaker from '../components/MeetTheMaker.astro';
import EditorialBanner from '../components/EditorialBanner.astro';
import FeaturedProducts from '../components/FeaturedProducts.astro';
import Reviews from '../components/Reviews.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Handmade Turquoise Necklaces"
  description="One-of-a-kind beaded turquoise necklaces, handmade in Colorado. Each piece is unique. Shipped across the US."
>
  <Hero />
  <EditorialBanner
    title="Silver jewelry,"
    em="made by me."
    breakTitle={true}
    cta="Shop sterling"
    href="/silver-jewelry"
    align="left"
    variant="short"
    image="https://ozxbjwvwchesjgebenbv.supabase.co/storage/v1/object/public/media/7057ca61-0972-40fd-96d6-cb32781216b8.webp"
  />
  <FeaturedProducts />
  <Reviews />
  <ShopNewBanner />
  <MeetTheMaker />
  <Footer />
</Base>
