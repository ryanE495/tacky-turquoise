---
const BEADED_BG = 'https://ozxbjwvwchesjgebenbv.supabase.co/storage/v1/object/public/media/fa674f03-6145-4b55-9feb-83ce320f846d.webp';
---
<section class="ed-banner ed-banner--short" aria-labelledby="shop-beaded-h">
  <a class="ed-banner__link" href="/shop">
    <img class="ed-banner__img" src={BEADED_BG} alt="" />
    <div class="ed-banner__overlay"></div>
    <div class="ed-banner__content">
      <h2 id="shop-beaded-h" class="ed-banner__title">Beaded <em>necklaces.</em></h2>
      <span class="ed-banner__cta">
        <span>Shop beaded</span>
        <span class="arrow" aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</section>
